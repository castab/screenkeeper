// Grafana Alloy configuration for a Screenkeeper Edge (player) host.
//
// One Alloy instance runs per host, as its own systemd service, independent
// of Screenkeeper's own units -- see deploy/alloy/README.md. It:
//   1. scrapes the local Prometheus endpoints Screenkeeper exposes
//   2. scrapes curated host metrics
//   3. attaches player/location identity, if this host is enrolled
//   4. remote_writes everything to a central Prometheus-compatible backend
//   5. receives local OTLP traces (TV commands, playback start, control-plane
//      heartbeats) and forwards them to a central OTLP backend
//   6. tails this host's systemd journal for screenkeeper* units and ships it
//      to a central Loki-compatible backend
//
// Every value that names the central backend or carries a credential comes
// from Alloy's own environment (sys.env()) -- Screenkeeper never sees it, and
// this file has no default for it: an operator must set it before Alloy can
// export anything. Screenkeeper keeps running with or without Alloy present.

// ---------------------------------------------------------------------------
// Screenkeeper application metrics
// ---------------------------------------------------------------------------

discovery.relabel "screenkeeper" {
	targets = [
		// `signage-controller run`. Absent/unreachable if metrics are disabled
		// or the process isn't running -- a normal, harmless scrape failure.
		{"__address__" = "127.0.0.1:9464", "job" = "signage_controller"},
		// `signage-controller playback run` binds metrics.port + 1.
		{"__address__" = "127.0.0.1:9465", "job" = "signage_controller_playback"},
		// `signage-controller agent run` binds metrics.port + 2.
		{"__address__" = "127.0.0.1:9466", "job" = "signage_controller_agent"},
	]

	rule {
		target_label = "instance"
		replacement  = sys.env("HOSTNAME")
	}
}

prometheus.scrape "screenkeeper" {
	targets         = discovery.relabel.screenkeeper.output
	scrape_interval = "15s"
	forward_to      = [prometheus.relabel.identity.receiver]
}

// ---------------------------------------------------------------------------
// Host metrics -- a curated set, not everything node_exporter can expose.
// Answers: is this host resource-constrained, filling up disk, or silent?
// ---------------------------------------------------------------------------

prometheus.exporter.unix "host" {
	set_collectors = ["cpu", "meminfo", "diskstats", "filesystem", "loadavg", "netdev", "uptime"]
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.identity.receiver]
}

// ---------------------------------------------------------------------------
// Player/location identity enrichment.
//
// SCREENKEEPER_PLAYER_ID / _LOCATION_ID / _ORGANIZATION_ID are populated by
// render-identity-env.sh from this host's device.json, loaded into Alloy's
// own environment via EnvironmentFile= (see deploy/alloy/README.md). Before
// enrollment, or if that file is absent, sys.env() returns "" -- Alloy still
// starts, still scrapes, and still exports; the fleet-identity labels are
// just empty until the player is enrolled.
// ---------------------------------------------------------------------------

prometheus.relabel "identity" {
	forward_to = [prometheus.remote_write.central.receiver]

	rule {
		target_label = "screenkeeper_player_id"
		replacement  = sys.env("SCREENKEEPER_PLAYER_ID")
	}
	rule {
		target_label = "screenkeeper_location_id"
		replacement  = sys.env("SCREENKEEPER_LOCATION_ID")
	}
	rule {
		target_label = "screenkeeper_organization_id"
		replacement  = sys.env("SCREENKEEPER_ORGANIZATION_ID")
	}
	rule {
		target_label = "environment"
		replacement  = sys.env("SCREENKEEPER_ENVIRONMENT")
	}
}

// ---------------------------------------------------------------------------
// Central export. The URL and credential are deployment configuration that
// belongs to Alloy, never to Screenkeeper -- see the boundary table in
// docs/architecture/observability.md. A bearer token, not basic auth: these
// are headless, unattended appliances, and a single rotatable token per
// fleet is simpler to provision than a username/password pair per host.
// ---------------------------------------------------------------------------

prometheus.remote_write "central" {
	endpoint {
		url = sys.env("METRICS_REMOTE_WRITE_URL")

		bearer_token = sys.env("METRICS_REMOTE_WRITE_TOKEN")

		// Alloy's own WAL/retry/buffering absorbs a WAN outage; nothing in
		// Screenkeeper needs to retry or buffer telemetry itself.
	}
}

// ---------------------------------------------------------------------------
// Local OTLP receiver -- http://127.0.0.1:4318 (and gRPC :4317), the contract
// documented in docs/architecture/observability.md's "OTLP readiness"
// section. signage-controller's optional `tracing:` config pushes spans here
// when enabled; metrics-over-OTLP has no application producer yet, so that
// path stays inert.
// ---------------------------------------------------------------------------

otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "127.0.0.1:4317"
	}
	http {
		endpoint = "127.0.0.1:4318"
	}

	output {
		metrics = [otelcol.exporter.prometheus.default.input]
		traces  = [otelcol.processor.attributes.identity.input]
	}
}

otelcol.exporter.prometheus "default" {
	forward_to = [prometheus.relabel.identity.receiver]
}

// ---------------------------------------------------------------------------
// Trace identity enrichment. Alloy has no otelcol.processor.resource
// component for injecting custom key/value pairs (only resourcedetection,
// which is for auto-detected host/cloud facts) -- these land as SPAN
// attributes, not true OTel Resource attributes. Still app-free identity
// attachment, the same principle as the Prometheus relabel rules above.
// ---------------------------------------------------------------------------

otelcol.processor.attributes "identity" {
	action {
		key    = "screenkeeper.player_id"
		value  = sys.env("SCREENKEEPER_PLAYER_ID")
		action = "upsert"
	}
	action {
		key    = "screenkeeper.location_id"
		value  = sys.env("SCREENKEEPER_LOCATION_ID")
		action = "upsert"
	}
	action {
		key    = "screenkeeper.organization_id"
		value  = sys.env("SCREENKEEPER_ORGANIZATION_ID")
		action = "upsert"
	}

	output {
		traces = [otelcol.exporter.otlp.central.input]
	}
}

otelcol.auth.bearer "central_traces" {
	token = sys.env("TRACES_OTLP_TOKEN")
}

otelcol.exporter.otlp "central" {
	client {
		endpoint = sys.env("TRACES_OTLP_ENDPOINT")
		auth     = otelcol.auth.bearer.central_traces.handler
	}
}

// ---------------------------------------------------------------------------
// Logs: tail this host's systemd journal for screenkeeper* units and ship to
// a central Loki-compatible backend. screenkeeper.service,
// screenkeeper-playback.service, and screenkeeper-agent.service are systemd
// *user* units, so their journal entries carry __journal__systemd_user_unit,
// not __journal__systemd_unit -- both are extracted into the same "unit"
// label, then everything else is dropped by the keep rule. Python's stdlib
// logging is untouched; this only adds a transport, same as metrics/traces.
// ---------------------------------------------------------------------------

loki.relabel "journal_unit" {
	// Only .rules is consumed (by loki.source.journal below); this instance
	// is never itself a hop in the log data path, so forward_to is empty.
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
	rule {
		source_labels = ["__journal__systemd_user_unit"]
		target_label  = "unit"
	}
	rule {
		source_labels = ["unit"]
		regex         = "screenkeeper.*\\.service"
		action        = "keep"
	}
}

loki.source.journal "screenkeeper" {
	forward_to    = [loki.write.central.receiver]
	relabel_rules = loki.relabel.journal_unit.rules
	labels        = {component = "loki.source.journal"}
}

loki.write "central" {
	endpoint {
		url          = sys.env("LOGS_REMOTE_WRITE_URL")
		bearer_token = sys.env("LOGS_REMOTE_WRITE_TOKEN")
	}
}
