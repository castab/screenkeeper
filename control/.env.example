# Copy this file to .env (already gitignored) and fill in real values.
# Never commit the real .env, and never commit a real admin token or
# database password anywhere in this repository.

# Generate a strong random admin token, e.g.: openssl rand -hex 32
# There is no default -- screenkeeper-control refuses to start without one.
SCREENKEEPER_ADMIN_TOKEN=

# Any value works for local development. Use a real secret manager in
# production; this is only consumed by compose.dev.yaml locally.
SCREENKEEPER_DATABASE_PASSWORD=devpassword
